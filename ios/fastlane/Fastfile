# Fastfile for Swift Evolution Quiz

default_platform(:ios)

platform :ios do
  # App Store Connect API キー認証（.env から読み込み）。設定済みなら全レーン共通で使われる。
  before_all do
    if ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_PATH"]
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: ENV["ASC_KEY_PATH"],
        in_house: false
      )
    end
  end

  desc "Upload metadata to App Store Connect"
  lane :upload_metadata do
    deliver(
      app_identifier: ENV["APP_IDENTIFIER"],
      skip_screenshots: false,
      skip_binary_upload: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end

  desc "Upload metadata only (no screenshots)"
  lane :upload_metadata_only do
    deliver(
      app_identifier: ENV["APP_IDENTIFIER"],
      skip_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end

  desc "Download existing metadata from App Store Connect"
  lane :download_metadata do
    download_metadata(
      app_identifier: ENV["APP_IDENTIFIER"]
    )
  end

  desc "Verify metadata before upload (dry run, no upload)"
  lane :preview_metadata do
    deliver(
      app_identifier: ENV["APP_IDENTIFIER"],
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      verify_only: true
    )
  end
end
