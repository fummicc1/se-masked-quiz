# Fastfile for Swift Evolution Quiz

default_platform(:ios)

platform :ios do
  # App Store Connect API キー認証（.env から読み込み）。設定済みなら全レーン共通で使われる。
  before_all do
    if ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_PATH"]
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: ENV["ASC_KEY_PATH"],
        in_house: false
      )
    end
  end

  desc "Upload metadata to App Store Connect"
  lane :upload_metadata do
    deliver(
      app_identifier: ENV["APP_IDENTIFIER"],
      skip_screenshots: false,
      skip_binary_upload: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end

  desc "Upload metadata only (no screenshots)"
  lane :upload_metadata_only do
    deliver(
      app_identifier: ENV["APP_IDENTIFIER"],
      skip_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end

  desc "Download existing metadata from App Store Connect"
  lane :download_metadata do
    download_metadata(
      app_identifier: ENV["APP_IDENTIFIER"]
    )
  end

  desc "Build and upload a new build to TestFlight"
  lane :release_testflight do
    build_app(
      project: "se-masked-quiz.xcodeproj",
      scheme: "se-masked-quiz",
      sdk: "iphoneos",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        teamID: "S8WBNKMKYU",
        signingStyle: "automatic"
      },
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      app_identifier: ENV["APP_IDENTIFIER"],
      skip_waiting_for_build_processing: true
    )
  end

  desc "Submit the already-uploaded build for App Store review"
  lane :submit_for_review do
    deliver(
      app_identifier: ENV["APP_IDENTIFIER"],
      app_version: "1.7.0",
      build_number: "8",
      skip_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: false,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: true,
      automatic_release: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Preview the local release notes to be uploaded (no network, no auth)"
  lane :preview_metadata do
    %w[ja en-US].each do |locale|
      # fastlane の cwd が ios/ か ios/fastlane/ かに依存しないよう両候補を試す
      candidates = [
        "fastlane/metadata/#{locale}/release_notes.txt",
        "metadata/#{locale}/release_notes.txt",
      ]
      path = candidates.find { |p| File.exist?(p) }
      UI.header("release_notes (#{locale})")
      UI.message(path ? File.read(path) : "(missing: tried #{candidates.join(', ')})")
    end
  end
end
